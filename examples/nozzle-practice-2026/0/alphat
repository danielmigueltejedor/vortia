FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}
dimensions      [1 -1 -1 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    axis { type empty; }
    inlet { type calculated; value uniform 0; }
    walls { type compressible::alphatWallFunction; value uniform 0; }
    atmosphere { type calculated; value uniform 0; }
    front { type wedge; }
    back  { type wedge; }
}